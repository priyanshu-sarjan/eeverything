# ========================================================================
# BharatLogistics & AgriFresh IoT - Environment Configuration
# ========================================================================

# [Optional] Mapbox Access Token for high-definition vector & satellite map tiles.
# Get a free token at https://account.mapbox.com/
# (If not provided, the system automatically uses ultra-crisp photorealistic
# open-source satellite imagery from Esri and detailed road maps from OpenStreetMap with zero setup!)
VITE_MAPBOX_TOKEN=

# [Optional] Google Maps Platform API Key
# If you want to use Google Maps Satellite / Hybrid tiles
VITE_GOOGLE_MAPS_API_KEY=

# [Optional] Custom Tile Server URL or API Key (e.g., Maptiler / Stadia)
VITE_MAP_API_KEY=

# Server Port (Default: 5000)
PORT=5000

